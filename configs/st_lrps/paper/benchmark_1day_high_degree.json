{
  "schema_version": 1,
  "name": "st_lrps_paper_1day_high_degree",
  "description": "Paper-safe 1-day high-degree orbit benchmark: ST-LRPS vs SH baselines against an SH200 DOP853 numerical reference. SH200 is a numerical reference, not physical truth.",
  "paper_safe": true,
  "scenario": {
    "seed": 42,
    "count": 100,
    "type": "bounded_keplerian",
    "altitude_min_km": 100.0,
    "altitude_max_km": 1000.0,
    "eccentricity_mode": "circular_to_elliptic",
    "inclination_mode": "full_range"
  },
  "propagation": {
    "duration_days": 1.0,
    "output_dt_s": 60.0,
    "integrator": "RK4",
    "dt_s": 30.0,
    "dtype": "float64"
  },
  "truth": {
    "model": "spherical_harmonics",
    "degree": 200,
    "integrator": "DOP853",
    "rtol": 1.0e-10,
    "atol": 1.0e-12,
    "gravity_file": null
  },
  "baselines": [
    {"name": "SH20", "model": "spherical_harmonics", "degree": 20},
    {"name": "SH30", "model": "spherical_harmonics", "degree": 30},
    {"name": "SH60", "model": "spherical_harmonics", "degree": 60},
    {"name": "SH100", "model": "spherical_harmonics", "degree": 100},
    {"name": "SH200_RK4", "model": "spherical_harmonics", "degree": 200, "allow_truth_duplicate": true}
  ],
  "surrogate": {
    "enabled": true,
    "name": "ST-LRPS",
    "model_dir": "<FILL: trained ST-LRPS run directory>",
    "baseline_degree": 20,
    "runtime_model_kind": "potential_autograd"
  },
  "outputs": {
    "out_dir": "validation/paper_evidence/st_lrps/orbit_benchmarks/benchmark_1day_high_degree",
    "write_figures": true,
    "write_csv": true,
    "write_json": true
  },
  "run_options": {
    "synthetic": false,
    "quick": false
  },
  "validation": {
    "allow_truth_baseline": true,
    "truth_baseline_justification": "SH200_RK4 is included only as the same-integrator numerical reference (the DOP853 SH200 truth uses a different integrator); it is labelled as a reference, not a competing physical model.",
    "strict_domain": true
  }
}
