# Shell scripts and Slurm batch files must keep LF line endings so they run on
# Linux HPC nodes even when edited or checked out on Windows. CRLF would break
# the `#!/usr/bin/env bash` shebang and `set -euo pipefail`.
*.sh        text eol=lf
*.sbatch    text eol=lf
*.slurm     text eol=lf
# Site profiles and scenario files are read on the cluster too: a CRLF copy
# leaves a carriage return in every value (partition "a100q").
hpc/**/*.env.example text eol=lf
hpc/scenarios/*.jsonl text eol=lf

# Preserve the exact executed bytes referenced by recorded sha256 pins: the
# rotating-validation evidence hashes its two runners, and every gravity-reference
# generator hashes its own file into its benchmark manifest. A CRLF checkout
# would change those bytes on Windows.
validation/gravity_reference/generators/**/*.py text eol=lf
