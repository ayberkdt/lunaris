{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayberkdt/lunaris/schemas/gravity-trajectory-reference-v1.json",
  "title": "Lunaris gravity trajectory reference manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "benchmark_id",
    "reference_class",
    "title",
    "reference_file",
    "time",
    "frames",
    "initial_state",
    "dynamics",
    "comparison"
  ],
  "properties": {
    "schema_version": {
      "const": "lunaris_gravity_trajectory_reference_v1"
    },
    "reference_class": {
      "enum": [
        "published_truth_trajectory",
        "external_tool_generated_trajectory",
        "mission_ephemeris_non_gravity_only",
        "incomplete_reference"
      ]
    },
    "time": {
      "type": "object",
      "required": ["initial_epoch", "time_scale", "duration_s", "output_step_s"],
      "properties": {
        "time_scale": {"enum": ["UTC", "TAI", "TT", "TDB", "ET"]},
        "duration_s": {"type": "number", "minimum": 0},
        "output_step_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "frames": {
      "type": "object",
      "required": ["state_center", "state_frame", "gravity_fixed_frame", "comparison_frame"],
      "properties": {
        "state_center": {"const": "MOON"},
        "state_frame": {"type": "string"},
        "gravity_fixed_frame": {"type": "string"},
        "comparison_frame": {"type": "string"},
        "frozen_from_frame": {"type": "string", "minLength": 1},
        "freeze_epoch": {"type": "string", "minLength": 1},
        "orientation_model": {"type": "string", "minLength": 1}
      }
    },
    "initial_state": {
      "type": "object",
      "required": ["representation", "position_unit", "velocity_unit", "state"],
      "properties": {
        "representation": {"const": "cartesian"},
        "position_unit": {"const": "m"},
        "velocity_unit": {"const": "m/s"},
        "state": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"type": "number"}
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["threshold_origin"],
      "properties": {
        "threshold_origin": {
          "enum": [
            "published",
            "official_software_validation",
            "convergence_derived_and_frozen",
            "report_only"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "frames": {
            "anyOf": [
              {
                "properties": {
                  "state_frame": {"const": "NONROTATING_FROZEN_BODY_FIXED"}
                }
              },
              {
                "properties": {
                  "gravity_fixed_frame": {"const": "NONROTATING_FROZEN_BODY_FIXED"}
                }
              },
              {
                "properties": {
                  "comparison_frame": {"const": "NONROTATING_FROZEN_BODY_FIXED"}
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "frames": {
            "required": [
              "frozen_from_frame",
              "freeze_epoch",
              "orientation_model"
            ],
            "properties": {
              "state_frame": {"const": "NONROTATING_FROZEN_BODY_FIXED"},
              "gravity_fixed_frame": {"const": "NONROTATING_FROZEN_BODY_FIXED"},
              "comparison_frame": {"const": "NONROTATING_FROZEN_BODY_FIXED"},
              "orientation_model": {"const": "identity_regression_fixture"}
            }
          }
        }
      }
    }
  ]
}
