# Lunaris HPC site configuration (TEMPLATE).
#
# Copy this file to `hpc/cluster.env` and fill in the values for YOUR cluster.
# `hpc/cluster.env` is git-ignored, so your site-specific settings (account,
# partition, module names, venv path) never get committed. Every hpc/*.sbatch
# job sources it through `env_template.sh`, and `hpc/submit.sh` reads the
# scheduler values below so you never have to edit the .sbatch files by hand.
#
#   cp hpc/cluster.env.example hpc/cluster.env
#   $EDITOR hpc/cluster.env
#
# Leave a value empty (or commented out) to skip it — empty values are treated
# as "not set" and the corresponding step is silently no-op'd.

# --- Scheduler placement (used by hpc/submit.sh to build sbatch flags) ------ #
# Slurm partition / queue, e.g. "gpu" or "a100".
LUNARIS_PARTITION=""
# Allocation/account to charge, e.g. "proj1234". Leave empty if your site does
# not require -A/--account.
LUNARIS_ACCOUNT=""
# Quality-of-service, e.g. "normal" or "gpu-long". Optional.
LUNARIS_QOS=""
# Generic resource request (GPUs). Override the per-script default, e.g.
# "gpu:1", "gpu:a100:2". Leave empty to keep each .sbatch file's own --gres.
LUNARIS_GRES=""

# --- Environment activation (used by env_template.sh inside every job) ------ #
# Space-separated list of modules to `module load`, in order. Match your
# cluster's module names, e.g. "cuda/12.1 cudnn/8.9". Leave empty if your
# cluster does not use Environment Modules.
LUNARIS_MODULES=""
# Absolute path to a venv activate script to source, e.g.
# "$HOME/venvs/lunaris/bin/activate". Created by hpc/setup_env.sh.
LUNARIS_VENV=""
# OR: a conda environment name to `conda activate`. Used only when LUNARIS_VENV
# is empty. Leave empty if you use a venv.
LUNARIS_CONDA_ENV=""

# --- Storage (read by the framework / passed through to --out-dir) ---------- #
# External data root (gravity models, ephemeris, topography, datasets).
LUNARIS_DATA_DIR="/scratch/$USER/lunaris_data"
# Run-output root (training runs, evaluations, benchmarks, batch runs).
LUNARIS_OUTPUT_DIR="/scratch/$USER/lunaris_outputs"

# --- Threading (sensible CPU defaults; tune to --cpus-per-task) ------------- #
OMP_NUM_THREADS="4"
MKL_NUM_THREADS="4"
