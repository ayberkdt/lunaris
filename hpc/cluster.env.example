# Lunaris HPC site configuration (TEMPLATE).
#
# Copy this file to `hpc/cluster.env` and fill in the values for YOUR cluster.
# `hpc/cluster.env` is git-ignored, so your site-specific settings (account,
# partition, module names, venv path) never get committed. Every hpc/*.sbatch
# job sources it through `env_template.sh`, and `hpc/submit.sh` reads the
# scheduler values below so you never have to edit the .sbatch files by hand.
#
#   cp hpc/cluster.env.example hpc/cluster.env
#   $EDITOR hpc/cluster.env
#
# Keep LF line endings (check with `file hpc/cluster.env`): a CRLF file leaves a
# carriage return at the end of every value.
#
# Leave a value empty (or commented out) to skip it — empty values are treated
# as "not set" and the corresponding step is skipped.

# --- Scheduler placement/resources (hpc/submit.sh builds sbatch flags) ------ #
# Slurm partition / queue, e.g. "gpu" or "a100". Find yours with: sinfo -s
LUNARIS_PARTITION=""
# Optional CPU partition for CPU-only jobs (dataset generation, CPU batch
# ensembles). When set, `hpc/submit.sh generate` and CPU-only `batch` jobs use it
# instead of LUNARIS_PARTITION, so a GPU queue above doesn't capture CPU work.
# Leave empty to reuse LUNARIS_PARTITION.
LUNARIS_CPU_PARTITION=""
# Allocation/account to charge, e.g. "proj1234". Leave empty if your site does
# not require -A/--account. Find yours with:
#   sacctmgr show assoc user=$USER format=account,qos
LUNARIS_ACCOUNT=""
# Quality-of-service, e.g. "normal" or "gpu-long". Optional (same command).
LUNARIS_QOS=""
# Generic resource request (GPUs) added to the GPU jobs (train, scenario,
# benchmark and GPU-backend batch jobs), e.g. "gpu:1", "gpu:a100:1". Leave empty
# to keep each .sbatch file's own --gres. Training uses ONE GPU: more sit idle.
LUNARIS_GRES=""

# Optional job-resource overrides injected by hpc/submit.sh. Leave empty to use
# the defaults in each .sbatch template. These are especially useful for the
# long resume_denemesi reproduction without editing tracked Slurm files.
# Examples: "8", "32G", "48:00:00", "B:TERM@1800" (graceful-stop signal, here
# 30 minutes before walltime; must exceed one epoch plus validation).
LUNARIS_CPUS_PER_TASK=""
LUNARIS_MEM=""
LUNARIS_TIME=""
LUNARIS_SIGNAL=""

# Set to 1 to let a training job that was stopped by the walltime signal (exit
# status 75, checkpoint saved) requeue itself and continue from the checkpoint.
# Needs an explicit --out-dir on the train job. Optional.
# LUNARIS_AUTO_REQUEUE=1

# --- Environment activation (used by env_template.sh inside every job) ------ #
# Space-separated list of modules to `module load`, in order. Match your
# cluster's module names (list them with: module avail), e.g.
# "Python/3.11.6 CUDA/12.4". Leave empty if your cluster does not use
# Environment Modules.
LUNARIS_MODULES=""
# The venv DIRECTORY the jobs activate (${LUNARIS_VENV}/bin/activate). Created by
# hpc/setup_env.sh at this same path; default $HOME/venvs/lunaris.
LUNARIS_VENV="$HOME/venvs/lunaris"
# OR: a conda environment name to `conda activate`. When set, it is used instead
# of the venv. Leave empty if you use a venv.
LUNARIS_CONDA_ENV=""

# --- Storage ---------------------------------------------------------------- #
# These use `:=` so a value already exported in your submit shell
# (e.g. `export LUNARIS_OUTPUT_DIR=/project/...` before `sbatch`) is respected;
# the assignments below only apply when the variable is unset. Switch to plain
# `VAR="..."` if you instead want cluster.env to always win.
# Defaults to $HOME; point these at your site's scratch/project area when $HOME
# has a small quota (10M-point cloud suites reach tens of GB; check: quota -s).
# External data root (gravity models, ephemeris, topography, datasets).
: "${LUNARIS_DATA_DIR:=$HOME/lunaris_data}"
# Run-output root (training runs, evaluations, benchmarks, batch runs).
: "${LUNARIS_OUTPUT_DIR:=$HOME/lunaris_outputs}"
# Root for the per-job scratch directories (TMPDIR and the numba cache; each job
# creates and removes its own subdirectory). Node-local disk is best. When
# empty, ${TMPDIR:-/tmp} is used.
# LUNARIS_SCRATCH_DIR=""

# Thread pools (OMP/MKL/OpenBLAS/numba) follow --cpus-per-task automatically
# (1 outside Slurm); export LUNARIS_THREADS to override all four.

export LUNARIS_DATA_DIR LUNARIS_OUTPUT_DIR
