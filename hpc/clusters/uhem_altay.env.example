# Lunaris HPC site configuration — UHeM Altay (Istanbul Technical University).
#
# Pre-filled profile for the UHeM Altay cluster. Copy it over the generic
# site-config location and adjust only what differs for your allocation:
#
#   cp hpc/clusters/uhem_altay.env.example hpc/cluster.env
#   $EDITOR hpc/cluster.env   # verify account/paths, then save
#   file hpc/cluster.env      # must say "ASCII text" without "CRLF"
#
# `hpc/cluster.env` stays git-ignored, so local edits never get committed.
# Field semantics are documented in hpc/cluster.env.example; this file only
# records the Altay-specific values.
#
# Lines marked ">>> FILL IN" are values that could NOT be confirmed from the
# repository. Each names the exact command to run ON THE CLUSTER that finds the
# value; the live assignment below it is left empty (safe) until you set it.

# --- Scheduler placement/resources ------------------------------------------ #
# Single-A100 queue. ST-LRPS training is single-GPU by design (the trainer
# drives one `cuda` device; there is no DDP/multi-GPU path — see docs/HPC.md
# "One GPU per training job"), so request a100q with gpu:1. Do NOT use the
# multi-GPU a100x4q queue: the extra GPUs would sit idle.
# Check the queue limits (MaxTime, nodes, state) with: scontrol show partition a100q
LUNARIS_PARTITION="a100q"
# >>> FILL IN: CPU queue for `hpc/submit.sh generate` and CPU-only batch jobs
# (no GPU needed). Pick a CPU partition from the list printed by:  sinfo -s
# While empty, those jobs also go to a100q.
LUNARIS_CPU_PARTITION=""
# UHeM allocation/account to charge (verify against your own allocation with:
# sacctmgr show assoc user=$USER format=account,qos).
LUNARIS_ACCOUNT="ydymif"
# >>> FILL IN: QOS, if your account requires one for a100q. The same command
# lists it: sacctmgr show assoc user=$USER format=account,qos
# Leave empty to use the account's default QOS.
LUNARIS_QOS=""
LUNARIS_GRES="gpu:1"
# The CPU-only dataset-generation job (`hpc/submit.sh generate`) ignores
# LUNARIS_GRES automatically, so this GPU request does not leak into it.

# Optional job-resource overrides (empty = keep each .sbatch template default).
LUNARIS_CPUS_PER_TASK=""
LUNARIS_MEM=""
LUNARIS_TIME=""
# Graceful-stop signal lead time (default B:TERM@1800 = 30 minutes before
# walltime). It must exceed one epoch plus validation, or the job is killed
# unsaved. Example for slow epochs: LUNARIS_SIGNAL="B:TERM@3600"
LUNARIS_SIGNAL=""

# Optional: requeue a training job that the walltime signal stopped after it
# saved its checkpoint (exit status 75). Needs an explicit --out-dir.
# LUNARIS_AUTO_REQUEUE=1

# --- Environment activation -------------------------------------------------- #
# Altay module providing Python 3.11 (the HPC lock targets CPython 3.11).
# CUDA module: torch from the lock ships its own CUDA runtime (pip wheels), so a
# CUDA module is optional for training; it supplies libNVVM for the numba CUDA
# batch backend (numba_cuda_sh) and nvcc. >>> FILL IN the exact name printed by:
#   module avail CUDA
# then append it, e.g.:
#   LUNARIS_MODULES="Python/Python-3.11.6-openmpi-4.1.6-gcc-11.4.0 CUDA/<version>"
# NOTE: the lock's torch is built for CUDA 13 and needs an NVIDIA driver >= 580 on
# the GPU nodes; hpc/preflight.sh checks this inside a GPU job. If the driver is
# older, install a torch for an older CUDA (LUNARIS_TORCH_INDEX_URL, hpc/setup_env.sh).
LUNARIS_MODULES="Python/Python-3.11.6-openmpi-4.1.6-gcc-11.4.0"
# The venv directory; created by `bash hpc/setup_env.sh` on an Altay login node.
LUNARIS_VENV="$HOME/venvs/lunaris"
LUNARIS_CONDA_ENV=""

# --- Storage ------------------------------------------------------------------ #
# >>> FILL IN: initial Altay policy is to keep data and outputs under $HOME rather
# than blindly assuming a /scratch mount. Mind your $HOME quota (show it with:
# quota -s) — 10M-point cloud suites reach tens of GB. If UHeM assigns you a
# project/scratch area, point both variables there instead. `:=` means an
# already-exported value in your submit shell still wins.
: "${LUNARIS_DATA_DIR:=$HOME/lunaris_data}"
: "${LUNARIS_OUTPUT_DIR:=$HOME/lunaris_outputs}"
# >>> FILL IN: root for the per-job scratch (TMPDIR and the numba cache). Node-local
# disk is best; find what the compute nodes offer inside a job with: df -h /tmp
# $TMPDIR. While empty, ${TMPDIR:-/tmp} is used.
# LUNARIS_SCRATCH_DIR=""

# Thread pools follow --cpus-per-task automatically (see env_template.sh).

export LUNARIS_DATA_DIR LUNARIS_OUTPUT_DIR
